FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// ---- 通量格式 fluxScheme ----
// 可选: Kurganov (原生 KNP, 默认), AUSM, Roe (另保留 Tadmor)
//   Kurganov: 原生 KNP 中心格式 (Riemann-free), 不受 convSchemes 等
//            新选项影响, 结果与原 hyStrath 一致
//   AUSM:     AUSM+-up 通量, 面值重构由 convSchemes 指定
//   Roe:      Roe 通量差分分裂, 面值重构由 convSchemes 指定,
//            熵修正系数由 EntropyCoeff 指定
fluxScheme            Kurganov;

// ---- 对流重构格式 convSchemes (仅 fluxScheme = AUSM/Roe 时生效) ----
// 可选: MUSCL, WENOZ5, WENOZ7 (默认 MUSCL)
//   MUSCL:   3 阶 MUSCL 重构 (κ/限制器可调), TVD 限制器使光滑区渐近 2 阶
//   WENOZ5:  5 阶 WENO-Z (Borges 2008)
//   WENOZ7:  7 阶 WENO-Z
// 注: AUSM/Roe 系列仅适用于结构化网格 (blockMesh 六面体),
//     存在非轴对齐内部面时启动即报错退出 (structuredStencilBuild
//     要求 100% 轴对齐, 不再静默降阶); 非结构网格请用 Kurganov
convSchemes          MUSCL;

// ---- AUSM+up 远场马赫数 Mach_inf (仅 fluxScheme = AUSM 时必需) ----
// 低马赫修正参数 fa/Mref 需要, 须为正实数 (取算例来流马赫数);
// 其余格式指定了会被忽略并提示。缺省时 AUSM 启动即报错。
//Mach_inf            8.0;

// ---- MUSCL 重构选项 (仅 convSchemes = MUSCL 时生效) ----
// 限制器可选: minmod, vanLeer, superbee, vanAlbada (默认 vanAlbada)
MUSCLLimiter         vanAlbada;
// kappa 系数: 1/3 (默认, 3 阶); 0 或 ±1 (2 阶); -1 为迎风型
MUSCLKappa           0.333333;

// ---- Roe 熵修正 (Harten-Hyman 1983 逐波, 仅 fluxScheme = Roe 时生效) ----
// eps_k = EntropyCoeff*4*max(0, max(lambda_k_hat - lambda_k_L, lambda_k_R - lambda_k_hat))
// |lambda| < eps 时: (lambda^2 + eps^2)/(2 eps); 默认 1.0 = SU2 NEMO 原样
// (含其固有的 4 倍安全因子, 保证膨胀扇内修正必然激活);
// 波不跨越 (压缩波/接触间断) 时 eps = 0, 修正自动关闭。
// EntropyCoeff = 0.25 可去掉 4 倍因子, 回到教科书 Harten-Hyman 带宽
EntropyCoeff         1.0;

// ---- 时间离散 ----
// 可选: Euler, localEuler, CrankNicolson 1, backward
// localEuler 激活 LTS 局部时间步进 (伪时间定常收敛):
//   局部 Δt = 1/max(rDeltaT), rDeltaT 由 maxCo/maxDeltaT (controlDict) 控制;
//   已知现状 (2026-09 审查): controlDict 的 rDeltaTSmoothingCoeff 为死参数
//   (代码固定 0.1), rDeltaTDampingCoeff/alphaTemp 未使用 (化学反应时标
//   限制在 setrDeltaT.H 中被禁用) — 反应流算例勿依赖 LTS 化学保护
ddtSchemes
{
    default           Euler;
}

// ---- 梯度格式 ----
// gradSchemes (梯度离散):
//   Gauss linear              — 2 阶中心差分 (默认)
//   fourth                    — 4 阶紧致梯度 (需结构化六面体网格)
//   sixth                     — 6 阶紧致梯度 (需结构化六面体网格, 实验性)
//   leastSquares              — 最小二乘法 (适用于非结构/多面体网格)
//   cellLimited Gauss linear 1 — 带限制器的 2 阶梯度 (激波附近稳定)
//   cellMDLimited Gauss linear 1 — 多维限制器版本
gradSchemes
{
    default           Gauss linear;
  //grad(U)           cellLimited Gauss linear 1;  // 激波附近稳定
}

// ---- 散度格式 ----
divSchemes
{
    default           none;                   // hy2Foam 不通过 div 计算对流
    div(tauMC)        Gauss linear;           // 粘性应力散度
    div(phi,U)        Gauss limitedLinearV 1; // 速度对流 (非 hy2Foam 主路径)

    // 组分扩散通量
    div(diffusiveFluxes)   Gauss linear;
    div(phi,Yi_h)     Gauss limitedLinear 1;

    // 湍流模型 (选用 RANS 时需要)
    div(phi,k)        Gauss limitedLinear 1;
    div(phi,omega)    Gauss limitedLinear 1;
    div(phi,epsilon)  Gauss limitedLinear 1;

    // 电子存在时压力膨胀项
    div(U)            Gauss linear;
}

// ---- Laplacian 格式 ----
laplacianSchemes
{
    default           Gauss linear corrected;
}

// ---- 插值格式 ----
// interpolationSchemes:
//   default: linear / cubic / midpoint
//   reconstruct(rho), reconstruct(U), reconstruct(T):
//     linear  — 2 阶中心插值
//     vanLeer — van Leer TVD 限制器
//     vanLeerV — van Leer 矢量限制器 (用于速度)
//
// 注: 使用 fluxScheme AUSM/Roe (convSchemes 重构) 时,
//     内部面值由 MUSCL_WENO_Reconstruct.H 覆写,
//     reconstruct 设置仅影响:
//       (1) 非轴对齐面的内部面 (dirTag==0, 保留 upwind 结果)
//       (2) 边界面 (wall 为 zeroGradient, 实际不受 reconstruct 影响)
//     Kurganov/Tadmor 模式则完全依赖此段设置
interpolationSchemes
{
    default           linear;
    reconstruct(rho)  vanLeer;
    reconstruct(U)    vanLeerV;
    reconstruct(T)    vanLeer;
}

// ---- 面法向梯度格式 ----
// 可选: corrected, uncorrected, limited 0.5, orthogonal
snGradSchemes
{
    default          corrected;
}

