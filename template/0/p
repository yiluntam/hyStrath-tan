FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// 压力场 — 密度基求解器中的导出量:
// p 不是独立求解变量, 由 pEqn.H 每步从 ρ/e/(Y_i) 经状态方程重构
// (perfect2Gas: p = ρ·R·T), 此处 0/ 文件仅提供初始值与边界处理
// 出现欠松弛/超松弛设置时 p 边界法向梯度通常保持零梯度

#include "include/initialConditions"

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform $pressureField;

boundaryField
{
    INLET
    {
        type            fixedValue;
        value           uniform $pressureInlet;
    }

    // 壁面: ∂p/∂n = 0 (边界层近似)
    WALL
    {
        type            zeroGradient;  // ∂p/∂n = 0 (边界层近似)
    }

    #include "include/boundaries"
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
