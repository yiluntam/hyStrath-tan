FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "include/initialConditions"

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform $velocityField;

boundaryField
{
    // -- 超声速入口 (所有变量固定) --
    INLET
    {
        type            fixedValue;
        value           uniform ($velocityInlet 0 0);
    }

    // -- 壁面 (无滑移) --
    WALL
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }

    #include "include/boundaries"
}

